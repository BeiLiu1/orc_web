APP_PORT=8080
MAX_UPLOAD_MB=25

# Optional. If set, frontend users must fill the same token in the page.
ACCESS_TOKEN=

# Optional base image overrides for servers that cannot pull Docker Hub.
# Keep official images by default. On restricted networks, set these to
# images that your server can pull, then run: docker compose up -d --build
PYTHON_BASE_IMAGE=python:3.11-slim
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:1.27-alpine
